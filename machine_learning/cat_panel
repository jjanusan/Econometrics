}


def attach_predictions(df, result):
    """
    Joins the prediction columns from fit_multinomial onto a data frame with
    the same index as the input. Rows dropped along the way (missing time or
    id) get NaN.
    """
    if not df.index.is_unique:
        raise ValueError("The index of df is not unique. Run df.reset_index(drop=True) "
                         "before step 2, so predictions can be joined to the right row.")
    pred = result["predictions"]
    existing = [c for c in pred.columns if c in df.columns]
    if existing:
        print(f"Columns {existing} already exist and are overwritten.")
        df = df.drop(columns=existing)
    return df.join(pred, how="left")


def fit_multinomial(df, s):
    """
    Multinomial logit for a categorical Y. Estimates P(Y | X) on a training
    window and uses the model to:
      1. flag rows where the reported Y is unlikely (selective editing)
      2. impute Y where it is missing (multiple imputation)
      3. show how uncertain the aggregates are (cluster bootstrap on id)
      4. give every row a predicted Y (block 12b)

    s is a dict of settings. Missing keys are filled from DEFAULT_SETTINGS.
    Prints along the way and returns a dict with the results.
    """
    s = {**DEFAULT_SETTINGS, **s}
    warnings.filterwarnings("ignore", category=UserWarning, module="sklearn")
    warnings.filterwarnings("ignore", category=FutureWarning, module="sklearn")
    rng = np.random.default_rng(s["seed"])

    y_col = s["y_col"]
    id_col = s["id_col"]
    time_source = s["time_source"]
    date_col = s["date_col"]
    date_format = s["date_format"]
    year_col = s["year_col"]
    subperiod_col = s["subperiod_col"]
    month_col = s["month_col"]
    x_numeric = list(s["x_numeric"])
    x_categorical = list(s["x_categorical"])
    log_cols = list(s["log_cols"])
    season_as_x = bool(s["season_as_x"])
    frequency = s["frequency"]
    target_year = int(s["target_year"])
    target_subperiod = int(s["target_subperiod"])
    train_from_year = int(s["train_from_year"])
    train_to_year = int(s["train_to_year"])
    holdout_periods = int(s["holdout_periods"])
    n_validation = int(s["n_validation"])
    decay_candidates = [float(v) for v in s["decay_candidates"]]
    decay_min_gain = float(s["decay_min_gain"])
    epv_ridge_limit = float(s["epv_ridge_limit"])
    C_ridge = [float(v) for v in s["C_candidates"]]
    separation_limit = float(s["separation_limit"])
    min_count_setting = s["min_count"]
    other_label = str(s["other_label"])
    flag_share = float(s["flag_share"])
    p_threshold = s["p_threshold"]
    n_imputations = int(s["n_imputations"])
    mar_limit_pp = float(s["mar_limit_pp"])
    n_bootstrap = int(s["n_bootstrap"])
    bootstrap_reselect = bool(s["bootstrap_reselect"])
    save_dir = s["save_dir"]

    if y_col is None or y_col not in df.columns:
        raise ValueError(f"y_col = {y_col!r} is not in the data.")
    if not x_numeric and not x_categorical:
        raise ValueError("Pick at least one X (x_numeric or x_categorical).")
    for c in x_numeric + x_categorical:
        if c not in df.columns:
            raise ValueError(f"X column {c!r} is not in the data.")
    if y_col in x_numeric or y_col in x_categorical:
        raise ValueError(f"{y_col} cannot be both Y and X.")
    for c in log_cols:
        if c not in x_numeric:
            raise ValueError(f"log_cols: {c!r} must be a numeric X.")
    if frequency not in ("month", "quarter", "tertial", "year"):
        raise ValueError(f"frequency must be month, quarter, tertial or year, "
                         f"got: {frequency}")
    if train_from_year > train_to_year:
        raise ValueError("train_from_year cannot be larger than train_to_year.")

    # ---- 2. Time and keys ----

    per_year = {"month": 12, "quarter": 4, "tertial": 3, "year": 1}[frequency]
    letter = {"month": "M", "quarter": "Q", "tertial": "T", "year": ""}[frequency]

    def label(period):
        yr, sub = divmod(int(period), per_year)
        return f"{yr}" if per_year == 1 else f"{yr}{letter}{sub + 1}"

    d = df.copy()

    if time_source not in ("auto", "date", "year_subperiod", "year_month", "year"):
        raise ValueError("time_source must be auto, date, year_month, "
                         f"year_subperiod or year, got: {time_source}")

    def _date_ok(col, fmt):
        """True if the column reads as a date with sensible years."""
        if not col or col not in d.columns:
            return False, None
        parsed = pd.to_datetime(d[col].astype(str), errors="coerce", format=fmt)
        if parsed.isna().mean() > 0.05:
            return False, parsed
        y_min, y_max = parsed.dt.year.min(), parsed.dt.year.max()
        if pd.isna(y_min) or y_min < 1990 or y_max > 2100:
            return False, parsed
        return True, parsed

    # Find the finest available source. The number is how many periods per
    # year the source can give.
    sources = []
    date_good, dt_parsed = _date_ok(date_col, date_format)
    if date_good:
        sources.append(("date", 12))
    if month_col and month_col in d.columns:
        sources.append(("year_month", 12))
    if subperiod_col and subperiod_col in d.columns:
        sources.append(("year_subperiod", per_year))
    if year_col and year_col in d.columns:
        sources.append(("year", 1))
    if not sources:
        raise ValueError("No usable time column found. Set date_col, "
                         "month_col, subperiod_col or year_col.")

    if time_source == "auto":
        time_source, resolution = sources[0]
        print(f"Time source picked automatically: {time_source} "
              f"(candidates: {[k for k, _ in sources]})")
    else:
        hits = [v for k, v in sources if k == time_source]
        if not hits:
            raise ValueError(f"time_source = '{time_source}' is not available. "
                             f"Usable sources: {[k for k, _ in sources]}")
        resolution = hits[0]

    if per_year > resolution:
        possible = [f for f, n in [("month", 12), ("tertial", 3), ("quarter", 4),
                                   ("year", 1)] if n <= resolution]
        raise ValueError(
            f"frequency = '{frequency}' needs {per_year} periods per year, but "
            f"time source '{time_source}' only gives {resolution}. "
            f"Possible frequencies with current columns: {possible}. "
            "If you have a finer time column, point month_col or date_col to it.")

    if time_source != "year" and (not year_col or year_col not in d.columns) \
            and time_source != "date":
        raise ValueError(f"time_source = '{time_source}' needs year_col.")

    if time_source == "date":
        dt = dt_parsed
        share_nat = dt.isna().mean()
        y_min, y_max = dt.dt.year.min(), dt.dt.year.max()
        odd = (pd.notna(y_min) and y_min < 1990) or (pd.notna(y_max) and y_max > 2100)
        if share_nat > 0.05 or odd:
            print(f"WARNING: {date_col} cannot be read as a date with a year.")
            print(f"  {share_nat:.1%} became NaT, years from {y_min} to {y_max}.")
            print(f"  Raw examples: "
                  f"{d[date_col].dropna().astype(str).head(5).tolist()}")
            print("  If the column is DDMM or MMDD, it has no year. Put the month "
                  "in its own column and set time_source = 'year_month',")
            print(f"  or set time_source = 'year_subperiod' and use {year_col} "
                  f"and {subperiod_col}.")
            raise ValueError("Stopping: the time column is misread.")
        d["_year"] = dt.dt.year
        used = [date_col]
    else:
        d["_year"] = pd.to_numeric(d[year_col], errors="coerce")
        used = [year_col]

    if per_year == 1:
        # Frequency year: anything finer than year is ignored.
        d["_sub"] = 1
        if time_source in ("year_month", "year_subperiod"):
            print(f"Frequency is year, so "
                  f"{month_col if time_source == 'year_month' else subperiod_col} "
                  "is not read.")
    elif time_source == "date":
        d["_sub"] = {"month": dt.dt.month,
                     "quarter": dt.dt.quarter,
                     "tertial": (dt.dt.month - 1) // 4 + 1}[frequency]
    elif time_source == "year_month":
        mon = pd.to_numeric(d[month_col], errors="coerce")
        if mon.dropna().between(1, 12).mean() < 0.99:
            raise ValueError(f"{month_col} has values outside 1-12. "
                             f"Found: {[int(v) for v in sorted(mon.dropna().unique())[:15]]}")
        d["_sub"] = {"month": mon,
                     "quarter": (mon - 1) // 3 + 1,
                     "tertial": (mon - 1) // 4 + 1}[frequency]
        used.append(month_col)
    elif time_source == "year_subperiod":
        d["_sub"] = pd.to_numeric(d[subperiod_col], errors="coerce")
        if d["_sub"].dropna().between(1, per_year).mean() < 0.99:
            raise ValueError(f"{subperiod_col} has values outside 1-{per_year}, "
                             f"which frequency '{frequency}' needs. Found: "
                             f"{[int(v) for v in sorted(d['_sub'].dropna().unique())[:15]]}")
        used.append(subperiod_col)
    else:
        raise ValueError(f"time_source = 'year' needs frequency = 'year', not "
                         f"'{frequency}'. Give a finer time column.")

    print(f"Time taken from    : {', '.join(used)}")

    use_clusters = id_col is not None
    if not use_clusters:
        print("No id column given. No history profile is built, and the "
              "bootstrap draws single rows instead of units.")
    missing_key = d["_year"].isna() | d["_sub"].isna()
    if use_clusters:
        missing_key = missing_key | d[id_col].isna()
    if missing_key.any():
        print(f"WARNING: {int(missing_key.sum())} rows miss time or "
              f"{id_col} and are dropped.")
        d = d[~missing_key].copy()
    d["_year"] = d["_year"].astype(int)
    d["_sub"] = d["_sub"].astype(int)
    if use_clusters:
        d[id_col] = d[id_col].astype(str)
    d["period"] = d["_year"] * per_year + d["_sub"] - 1

    target_period = target_year * per_year + (target_subperiod - 1 if per_year > 1 else 0)
    window_from = train_from_year * per_year
    window_to = train_to_year * per_year + per_year - 1
    in_window = d["period"].between(window_from, window_to)

    window_periods = sorted(d.loc[in_window, "period"].unique())
    if len(window_periods) <= holdout_periods + 1:
        raise ValueError(f"Only {len(window_periods)} periods in the window. Widen "
                         "the window or lower holdout_periods.")
    holdout = window_periods[-holdout_periods:] if holdout_periods > 0 else []
    dev_periods = [q for q in window_periods if q not in holdout]
    last_dev = max(dev_periods)
    last_window = max(window_periods)

    print(f"Frequency          : {frequency} ({per_year} per year)")
    print(f"Target period      : {label(target_period)}")
    print(f"Training window    : {label(window_from)} to {label(window_to)}, "
          f"{len(window_periods)} periods")
    print(f"  development      : {label(dev_periods[0])} to {label(last_dev)}")
    print(f"  holdout          : {[label(q) for q in holdout] or 'none'}")
    gap = target_period - last_window
    if gap > 1:
        print(f"NOTE: {gap - 1} periods between the window and the target are not used.")
    if (d["period"] == target_period).sum() == 0:
        raise ValueError(f"No rows in the target period {label(target_period)}. "
                         "Check target_year and target_subperiod.")

    print("\nRows per period:")
    ov = d.groupby("period").size().rename("rows").reset_index()
    ov["period_label"] = ov["period"].map(label)
    ov["role"] = np.where(ov["period"] == target_period, "target",
                 np.where(ov["period"].isin(holdout), "holdout",
                 np.where(ov["period"].isin(dev_periods), "development", "")))
    print(ov[["period_label", "rows", "role"]].to_string(index=False))

    # ---- 3. Y and X ----

    d[y_col] = d[y_col].astype("string").str.strip()
    d.loc[d[y_col].isin(["", "nan", "<NA>", "None"]), y_col] = pd.NA

    for c in log_cols:
        d[c] = np.log(pd.to_numeric(d[c], errors="coerce").clip(lower=1))
    for c in x_numeric:
        d[c] = pd.to_numeric(d[c], errors="coerce")

    if season_as_x and per_year > 1:
        d["season"] = d["_sub"]
        x_categorical = [c for c in x_categorical
                         if c not in ("season", subperiod_col)] + ["season"]

    for c in x_categorical:
        n_missing = int(d[c].isna().sum())
        d[c] = d[c].astype("string").fillna("missing")
        if n_missing:
            print(f"{c}: {n_missing} rows have no value, coded as 'missing'")

    # Y levels below min_count are merged
    n_train = int(in_window.sum())
    if min_count_setting is None:
        min_count = max(100, 0.005 * n_train)
        print(f"\nmin_count automatic: {min_count:.0f} "
              f"(max(100, 0.5 percent of {n_train} rows in the window))")
    else:
        min_count = float(min_count_setting)
        print(f"\nmin_count set by hand: {min_count:.0f}")

    counts = d.loc[in_window, y_col].value_counts()
    small = counts[counts < min_count]
    if len(small) > 0:
        print(f"Merging {len(small)} Y levels into '{other_label}': "
              f"{list(small.index)} ({small.sum()} rows in the window)")
        d.loc[d[y_col].isin(small.index), y_col] = other_label

    # Levels that only exist outside the window
    valid_levels = set(d.loc[in_window, y_col].dropna().unique())
    unseen = d[y_col].notna() & ~d[y_col].isin(valid_levels)
    if unseen.any():
        print(f"{int(unseen.sum())} rows have Y levels not seen in the window "
              f"({sorted(d.loc[unseen, y_col].unique())}), coded as '{other_label}'.")
        d.loc[unseen, y_col] = other_label

    print("\nLevels per categorical X in the window:")
    for c in x_categorical:
        n_lev = d.loc[in_window, c].nunique()
        note = "  <- too many, group before running" if n_lev > 50 else ""
        print(f"  {c:18s} {n_lev:5d}{note}")

    # ---- 4. Unit history profile of Y ----
    # Only from periods in the window and only from periods BEFORE the row.

    if use_clusters:
        obs = d[d[y_col].notna() & in_window]
        tally = (obs.groupby([id_col, "period", y_col], observed=True).size()
                 .unstack(fill_value=0))
        all_periods = sorted(d["period"].unique())
        grid = pd.MultiIndex.from_product([d[id_col].unique(), all_periods],
                                          names=[id_col, "period"])
        tally = tally.reindex(grid, fill_value=0).sort_index()
        cum = tally.groupby(level=0, observed=True).cumsum()
        cum = cum.groupby(level=0, observed=True).shift(1).fillna(0)
        profile = cum.div(cum.sum(axis=1).replace(0, np.nan), axis=0)
        profile.columns = [f"hist_{c}" for c in profile.columns]
        profile["has_history"] = (cum.sum(axis=1) > 0).astype(float)
        base = obs[y_col].value_counts(normalize=True)
        for k in base.index:
            profile[f"hist_{k}"] = profile[f"hist_{k}"].fillna(base[k])
        d = d.join(profile, on=[id_col, "period"])
        x_num_all = x_numeric + list(profile.columns)
    else:
        x_num_all = list(x_numeric)

    # ---- 5. Design matrix, missing X, EPV, null model ----

    X = pd.get_dummies(d[x_num_all + x_categorical], columns=x_categorical,
                       drop_first=True, dtype=float)
    levels = sorted(d[y_col].dropna().unique())
    if len(levels) < 2:
        raise ValueError(f"Y has only {len(levels)} level after merging. "
                         "Lower min_count or pick another Y.")
    train = d[y_col].notna() & in_window
    dev = d[y_col].notna() & d["period"].isin(dev_periods)
    hold = d[y_col].notna() & d["period"].isin(holdout)
    target_obs = (d["period"] == target_period) & d[y_col].notna()
    target_na = (d["period"] == target_period) & d[y_col].isna()

    nan_cols = X.isna().sum()
    nan_cols = nan_cols[nan_cols > 0]
    if len(nan_cols):
        print("\nMissing values in X:")
        for c in list(nan_cols.index):
            print(f"  {c}: {nan_cols[c]} rows ({100 * nan_cols[c] / len(X):.2f} percent)")
            if X[c].isna().all():
                X = X.drop(columns=c)
                print(f"  {c} is empty and dropped.")
                continue
            X[f"missing_{c}"] = X[c].isna().astype(float)
            med = X.loc[train, c].median()
            med = X[c].median() if pd.isna(med) else med
            X[c] = X[c].fillna(0.0 if pd.isna(med) else med)

    # standardise on the training window, needed for ridge and good for convergence
    mu = X.loc[train].mean()
    sd = X.loc[train].std().replace(0, 1.0)
    X = (X - mu) / sd

    smallest = d.loc[train, y_col].value_counts().min()
    n_params = (len(levels) - 1) * X.shape[1]
    epv = smallest / n_params
    use_ridge = epv < epv_ridge_limit
    C_list = C_ridge if use_ridge else [np.inf]

    print(f"\nRows               : {len(d)}")
    if use_clusters:
        n_units = d[id_col].nunique()
        print(f"Units (clusters)   : {n_units} ({id_col})")
        if n_units < 30:
            print("  WARNING: fewer than 30 clusters. The cluster bootstrap then "
                  "gives too narrow intervals.")
        if id_col in x_categorical or id_col in x_numeric:
            print(f"  WARNING: {id_col} is both id and predictor. The profile then "
                  "becomes target coding of the same column, and the "
                  "coefficients become unstable.")
    else:
        print("Units (clusters)   : no id column")
    print(f"Y levels           : {len(levels)}  {levels}")
    print(f"Predictor columns  : {X.shape[1]}")
    print(f"Coefficients       : {n_params}")
    print(f"EPV                : {epv:.1f}  ->  "
          + ("ridge on" if use_ridge else "plain ML"))
    if epv < 10:
        print("  WARNING: EPV below 10. Results are likely miscalibrated.")
    if use_clusters:
        print(f"No history in target period: "
              f"{1 - d.loc[d['period'] == target_period, 'has_history'].mean():.1%}")

    # null model: guess the distribution in the development periods
    null_p = d.loc[dev, y_col].value_counts(normalize=True).reindex(levels).fillna(0)

    def fit(Xm, ym, per, decay, C, end):
        """Weighted multinomial logit. per is the period number per row."""
        w = decay ** (end - per)
        m = LogisticRegression(C=C, max_iter=3000)
        m.fit(Xm, ym, sample_weight=w)
        return m

    def loss(m, Xm, ym):
        return log_loss(ym, m.predict_proba(Xm), labels=list(m.classes_))

    def null_loss(ym):
        P = np.tile(null_p.to_numpy(), (len(ym), 1))
        return log_loss(ym, P, labels=levels)

    def choose(Xm, ym, per, periods):
        """Picks (decay, C) by out-of-time validation. Returns (scores, validation)."""
        ordered = sorted(periods)
        possible = ordered[2:]
        validation = possible[-n_validation:] if possible else []
        scores = {}
        for decay in decay_candidates:
            for C in C_list:
                t = []
                for q in validation:
                    tr = (per < q).to_numpy()
                    te = (per == q).to_numpy()
                    if tr.sum() < 100 or ym[tr].nunique() < len(levels):
                        continue
                    m = fit(Xm[tr], ym[tr], per[tr], decay, C, q - 1)
                    t.append(loss(m, Xm[te], ym[te]))
                if t:
                    scores[(decay, C)] = np.mean(t)
        return scores, validation

    # ---- 6. Is missing Y random given X? ----

    print("\nComparing X between rows with and without Y (window + target):")
    with_y = d[y_col].notna() & (in_window | (d["period"] == target_period))
    without_y = d[y_col].isna() & (in_window | (d["period"] == target_period))
    print(f"  {int(with_y.sum())} with Y, {int(without_y.sum())} without Y")
    mar_flags = []
    if without_y.sum() < 20:
        print("  Too few rows without Y to compare. Skipping.")
        x_cat_mar, x_num_mar = [], []
    else:
        x_cat_mar, x_num_mar = x_categorical, x_numeric
    for c in x_cat_mar:
        a = d.loc[with_y, c].value_counts(normalize=True)
        b = d.loc[without_y, c].value_counts(normalize=True)
        idx = a.index.union(b.index)
        diff = (b.reindex(idx).fillna(0) - a.reindex(idx).fillna(0)) * 100
        worst = diff.abs().idxmax()
        print(f"  {c:18s} largest gap {diff[worst]:+.1f} pp ({worst})")
        if abs(diff[worst]) > mar_limit_pp:
            mar_flags.append(c)
    for c in x_num_mar:
        s_with = pd.to_numeric(d.loc[with_y, c], errors="coerce").astype(float)
        s_without = pd.to_numeric(d.loc[without_y, c], errors="coerce").astype(float)
        sd_with = s_with.std()
        if s_without.notna().sum() == 0 or not np.isfinite(sd_with) or sd_with == 0:
            continue
        z = float((s_without.mean() - s_with.mean()) / sd_with)
        print(f"  {c:18s} mean difference {z:+.2f} sd")
        if abs(z) > 0.5:
            mar_flags.append(c)
    if without_y.sum() >= 20 and mar_flags:
        print(f"  WARNING: missing Y is skewed on {mar_flags}. The imputation "
              "can be biased where X does not capture the difference.")
    elif without_y.sum() >= 20:
        print("  No large differences. The MAR assumption looks reasonable.")

    # ---- 7. Out-of-time model choice on the development periods ----

    scores, validation = choose(X[dev], d.loc[dev, y_col], d.loc[dev, "period"],
                                dev_periods)
    print(f"\nOut-of-time model choice on {[label(q) for q in validation]}:")
    if not scores:
        best_decay, best_C = 1.0, C_list[0]
        print(f"  Too few periods to validate. decay = 1.0, C = {best_C}.")
    else:
        for (decay, C), v in sorted(scores.items()):
            print(f"  decay = {decay:.1f}  C = {C:<6}  log-loss = {v:.4f}")
        null_v = np.mean([null_loss(d.loc[dev & (d["period"] == q), y_col])
                          for q in validation])
        print(f"  null model (guess the distribution)   log-loss = {null_v:.4f}")
        (best_decay, best_C) = min(scores, key=scores.get)
        best, worst = min(scores.values()), max(scores.values())
        if (worst - best) / best < decay_min_gain:
            print(f"  Gap between best and worst is below "
                  f"{100 * decay_min_gain:.0f} percent. The choice is not "
                  "informative, using decay = 1.0.")
            best_decay = 1.0
            best_C = min((k for k in scores if k[0] == 1.0), key=scores.get,
                         default=(1.0, C_list[0]))[1]
        gain = 100 * (null_v - scores[(best_decay, best_C)]) / null_v
        print(f"  Best model is {gain:.1f} percent better than the null model.")
        if gain < 2:
            print("  WARNING: the model explains almost nothing beyond the "
                  "distribution. The predictors carry little information.")

    half = np.log(0.5) / np.log(best_decay) if best_decay < 1 else np.inf
    print(f"Chosen             : decay = {best_decay}"
          + (f" (half-life {half:.1f} periods)" if best_decay < 1 else "")
          + f", C = {best_C}")

    # ---- 8. Independent test on the holdout period ----
    # This period has not been used for any choice. One number, once.

    cal_hold = None
    if holdout:
        m_dev = fit(X[dev], d.loc[dev, y_col], d.loc[dev, "period"],
                    best_decay, best_C, last_dev)
        h_model = loss(m_dev, X[hold], d.loc[hold, y_col])
        h_null = null_loss(d.loc[hold, y_col])
        print(f"\nHoldout test on {[label(q) for q in holdout]} (n = {int(hold.sum())}):")
        print(f"  model log-loss {h_model:.4f}, null model {h_null:.4f}, "
              f"gain {100 * (h_null - h_model) / h_null:.1f} percent")
        cal_hold = pd.DataFrame({
            "predicted": pd.Series(m_dev.predict_proba(X[hold]).mean(axis=0),
                                   index=m_dev.classes_),
            "observed": d.loc[hold, y_col].value_counts(normalize=True)})
        cal_hold["gap_pp"] = 100 * (cal_hold["observed"] - cal_hold["predicted"])
        print(cal_hold.round(4).to_string())
        print("  Gaps here are model error, not data error. Use them as a "
              "reference for normal gaps in the target period.")

    # ---- 9. Main model on the full window ----

    model = fit(X[train], d.loc[train, y_col], d.loc[train, "period"],
                best_decay, best_C, last_window)
    target_all = (d["period"] == target_period)
    probs = pd.DataFrame(np.nan, index=d.index, columns=model.classes_)
    probs.loc[target_all, :] = model.predict_proba(X[target_all.to_numpy()])

    coef = pd.DataFrame(model.coef_, index=model.classes_, columns=X.columns)
    large = coef.abs().max()
    large = large[large > separation_limit]
    if len(large):
        print(f"\nWARNING: {len(large)} columns have |coefficient| above "
              f"{separation_limit} (standardised scale), a sign of separation:")
        for c, v in large.sort_values(ascending=False).head(10).items():
            print(f"  {c}: {v:.1f}")
        print("  Merge levels, or set epv_ridge_limit higher.")

    cal = pd.DataFrame({
        "predicted": probs.loc[target_obs].mean(),
        "observed": d.loc[target_obs, y_col].value_counts(normalize=True)})
    cal["gap_pp"] = 100 * (cal["observed"] - cal["predicted"])
    print(f"\nCalibration in target period {label(target_period)} "
          f"(n = {int(target_obs.sum())}):")
    print(cal.round(4).to_string())

    # ---- 10. Selective editing ----

    reported = d.loc[target_obs, y_col]
    d.loc[target_obs, "p_reported"] = probs.loc[target_obs].to_numpy()[
        np.arange(int(target_obs.sum())),
        [list(model.classes_).index(k) for k in reported]]
    d.loc[target_obs, "expected"] = probs.loc[target_obs].idxmax(axis=1)

    if p_threshold is not None:
        flagged = target_obs & (d["p_reported"] < float(p_threshold))
        reason = f"probability below {p_threshold}"
    else:
        d.loc[target_obs, "rank_pct"] = d.loc[target_obs, "p_reported"].rank(pct=True)
        flagged = target_obs & (d["rank_pct"] <= flag_share)
        reason = (f"the weakest {100 * flag_share:.0f} percent, equal to "
                  f"p below {d.loc[flagged, 'p_reported'].max():.4f}")

    print(f"\nSelective editing: {int(flagged.sum())} rows flagged ({reason})")
    print("Flags as share of rows in the group:")
    for col in x_categorical:
        a = (d.loc[flagged].groupby(col, observed=True).size()
             / d.loc[target_obs].groupby(col, observed=True).size()).dropna()
        if a.nunique() > 1:
            print(f"  {col}: highest {a.idxmax()} {a.max():.3f}, "
                  f"lowest {a.idxmin()} {a.min():.3f}")
    if use_clusters:
        most = d.loc[flagged, id_col].value_counts().head(5)
        print("Units with most flags: " + str({str(k): int(v) for k, v in most.items()}))

    if "is_error" in d.columns:            # demo only, remove for real data
        n_err = int(d.loc[target_obs, "is_error"].sum())
        found = int(d.loc[flagged, "is_error"].sum())
        print(f"[demo] caught {found} of {n_err} planted errors, a random "
              f"sample would give {n_err / int(target_obs.sum()) * flagged.sum():.1f}")

    # ---- 11. Multiple imputation ----

    imputation = None
    print(f"\nMissing Y in the target period: {int(target_na.sum())} rows")
    if target_na.sum() > 0:
        p_na = probs.loc[target_na].to_numpy()
        shares = []
        for i in range(n_imputations):
            drawn = [rng.choice(model.classes_, p=r) for r in p_na]
            shares.append(pd.concat([d.loc[target_obs, y_col], pd.Series(drawn)])
                          .value_counts(normalize=True))
        imputation = pd.DataFrame(shares)
        print(f"Share after imputation ({n_imputations} draws):")
        print(pd.DataFrame({"share": imputation.mean(), "sd_imp": imputation.std()})
              .round(4).to_string())

    # ---- 12. Cluster bootstrap ----

    X_np = X.to_numpy()
    y_np = d[y_col].to_numpy()
    per_np = d["period"].to_numpy()
    y_ok = d[y_col].notna().to_numpy()
    in_window_np = d["period"].between(window_from, window_to).to_numpy()
    dev_np = d["period"].isin(dev_periods).to_numpy()
    X_target = X_np[target_obs.to_numpy()]
    n_levels = len(levels)

    if use_clusters:
        units = d[id_col].unique()
        rows_per_unit = d.groupby(id_col, observed=True).indices

    # Draw all indices first, in order, so the draws do not depend on
    # how the work is split across cores.
    all_idx = []
    for b in range(n_bootstrap):
        if use_clusters:
            picked = rng.choice(units, len(units), replace=True)
            all_idx.append(np.concatenate([rows_per_unit[u] for u in picked]))
        else:
            all_idx.append(rng.choice(len(d), len(d), replace=True))

    def one_round(idx):
        mask = y_ok[idx] & in_window_np[idx]
        tr = idx[mask]
        if len(tr) < 100 or len(np.unique(y_np[tr])) < n_levels:
            return None
        decay_b, C_b = best_decay, best_C
        if bootstrap_reselect:
            dev_b = idx[mask & dev_np[idx]]
            scores_b, _ = choose(X_np[dev_b], pd.Series(y_np[dev_b]),
                                 pd.Series(per_np[dev_b]), dev_periods)
            if scores_b:
                decay_b, C_b = min(scores_b, key=scores_b.get)
        w = decay_b ** (last_window - per_np[tr])
        mb = LogisticRegression(C=C_b, max_iter=3000)
        mb.fit(X_np[tr], y_np[tr], sample_weight=w)
        return pd.Series(mb.predict_proba(X_target).mean(axis=0), index=mb.classes_)

    boot = Parallel(n_jobs=-1)(delayed(one_round)(i) for i in all_idx)
    boot = pd.DataFrame([b for b in boot if b is not None])

    if len(boot) < 50:
        print(f"\nNOTE: only {len(boot)} bootstrap rounds. The intervals are "
              "unreliable. Set n_bootstrap to at least 100 for real use.")
    summary = pd.DataFrame({
        "predicted": probs.loc[target_obs].mean(),
        "boot_sd": boot.std(),
        "lower_95": boot.quantile(0.025),
        "upper_95": boot.quantile(0.975),
        "observed": d.loc[target_obs, y_col].value_counts(normalize=True)})
    summary["outside"] = ~summary["observed"].between(summary["lower_95"],
                                                      summary["upper_95"])
    print("\nBootstrap on "
          + (f"{id_col} (clusters)" if use_clusters else "single rows")
          + f", {len(boot)} rounds"
          + (" (decay/C chosen again each round)" if bootstrap_reselect
             else " (decay/C held fixed, uncertainty in that choice not included)")
          + ":")
    print(summary.round(4).to_string())
    outside = summary[summary["outside"]]
    print("Y levels outside the interval: "
          + (", ".join(outside.index) if len(outside) else "none"))

    # ---- 12b. Predicted Y per row ----
    # Most likely level for each row. In the target period this is out of
    # sample. In the window it is in sample and only a diagnostic.

    pred_name = str(s["prediction_col"])
    pred_rows = (pd.Series(True, index=d.index) if s["predict_all_rows"]
                 else (d["period"] == target_period))
    P = model.predict_proba(X[pred_rows.to_numpy()])
    classes = list(model.classes_)

    pred = pd.DataFrame(index=d.index[pred_rows])
    pred[pred_name] = np.array(classes)[P.argmax(axis=1)]
    pred[f"{pred_name}_p"] = P.max(axis=1)
    pred[f"{pred_name}_reported"] = d.loc[pred_rows, y_col].to_numpy()

    has_y = d.loc[pred_rows, y_col].notna().to_numpy()
    p_rep = np.full(len(pred), np.nan)
    if has_y.any():
        col_idx = [classes.index(k) for k in d.loc[pred_rows, y_col][has_y]]
        p_rep[has_y] = P[np.where(has_y)[0], col_idx]
    pred[f"{pred_name}_p_reported"] = p_rep

    per_pred = d.loc[pred_rows, "period"]
    pred[f"{pred_name}_role"] = np.select(
        [per_pred == target_period, per_pred.isin(holdout), per_pred.isin(dev_periods)],
        ["target", "holdout", "development"], default="outside window")
    pred[f"{pred_name}_differs"] = has_y & (
        pred[pred_name].to_numpy() != pred[f"{pred_name}_reported"].to_numpy())
    if s["prediction_all_probs"]:
        for j, k in enumerate(classes):
            pred[f"{pred_name}_p_{k}"] = P[:, j]

    print(f"\nPredicted Y stored in column '{pred_name}' for {len(pred)} rows.")
    print("Share of rows where predicted Y differs from reported, per role:")
    print((pred[pred[f"{pred_name}_reported"].notna()]
           .groupby(f"{pred_name}_role")[f"{pred_name}_differs"]
           .agg(rows="size", share_differs="mean")).round(3).to_string())
    print("  Differences in 'development' and 'holdout' are in sample and only "
          "a diagnostic. 'target' is out of sample.")
    n_no_y = int((~has_y).sum())
    if n_no_y:
        print(f"  {n_no_y} rows without reported Y got the most likely level. "
              "That is a single imputation; use the imputation table for aggregates.")

    # ---- 13. Saving ----

    used_settings = {"frequency": frequency, "time_source": time_source,
                     "decay": best_decay, "C": best_C, "epv": epv,
                     "n_bootstrap": len(boot), "min_count": min_count,
                     "prediction_col": pred_name}
    if save_dir:
        os.makedirs(save_dir, exist_ok=True)
        tag = f"{y_col}_{label(target_period)}"
        d.loc[flagged].to_parquet(f"{save_dir}/flagged_{tag}.parquet")
        pred.to_parquet(f"{save_dir}/predicted_{tag}.parquet")
        cal.to_csv(f"{save_dir}/calibration_{tag}.csv")
        summary.to_csv(f"{save_dir}/bootstrap_{tag}.csv")
        pd.Series({k: str(v) for k, v in used_settings.items()}).to_csv(
            f"{save_dir}/settings_{tag}.csv")
        print(f"\nSaved to {save_dir}/")

    return {
        "data": d, "X": X, "model": model, "probs": probs,
        "calibration": cal, "calibration_holdout": cal_hold, "summary": summary,
        "bootstrap": boot, "flagged": d.loc[flagged].copy(),
        "imputation": imputation, "predictions": pred, "settings": used_settings,
    }


def step_model(state):
    """
    Step 4: settings for the multinomial logit as widgets, and a button that
    runs fit_multinomial on the filtered data from step 2.

    Required choices are at the top. The rest is under "Advanced settings".
    Columns marked "may be None" can be set to "(none)".

    Results are stored in state["result"], and the data with predicted Y per
    row in state["predicted"].
    """
    none = "(none)"
    w = {"description_width": "200px"}
    wide = widgets.Layout(width="460px")
    narrow = widgets.Layout(width="300px")

    y_html = widgets.HTML()
    id_menu = widgets.Dropdown(description="id_col (may be None):", style=w, layout=wide)
    source_menu = widgets.Dropdown(
        options=["auto", "date", "year_month", "year_subperiod", "year"], value="auto",
        description="time_source:", style=w, layout=wide)
    date_menu = widgets.Dropdown(description="date_col (may be None):", style=w, layout=wide)
    date_fmt_field = widgets.Text(
        value="", placeholder="empty = automatic, e.g. %Y%m%d",
        description="date_format (may be None):", style=w, layout=wide)
    year_menu = widgets.Dropdown(description="year_col (may be None):", style=w, layout=wide)
    sub_menu = widgets.Dropdown(description="subperiod_col (may be None):", style=w, layout=wide)
    month_menu = widgets.Dropdown(description="month_col (may be None):", style=w, layout=wide)

    x_type_box = widgets.VBox()
    x_type_menus = {}
    log_menu = widgets.SelectMultiple(
        options=[], description="log_cols:", style=w,
        layout=widgets.Layout(width="460px", height="90px"))
    season_box = widgets.Checkbox(value=False, indent=False,
                                  description="season_as_x (subperiod as category)")

    freq_menu = widgets.Dropdown(
        options=["month", "quarter", "tertial", "year"], value="year",
        description="frequency:", style=w, layout=wide)
    target_year_field = widgets.IntText(value=2025, description="target_year:",
                                        style=w, layout=narrow)
    target_sub_field = widgets.IntText(value=1, description="target_subperiod:",
                                       style=w, layout=narrow)
    from_field = widgets.IntText(value=2015, description="train_from_year:",
                                 style=w, layout=narrow)
    to_field = widgets.IntText(value=2024, description="train_to_year:",
                               style=w, layout=narrow)
    holdout_field = widgets.IntText(value=1, description="holdout_periods:",
                                    style=w, layout=narrow)

    # advanced settings
    n_val_field = widgets.IntText(value=4, description="n_validation:", style=w, layout=narrow)
    decay_field = widgets.Text(value="1.0, 0.9, 0.8, 0.7, 0.5",
                               description="decay_candidates:", style=w, layout=wide)
    decay_gain_field = widgets.FloatText(value=0.01, description="decay_min_gain:",
                                         style=w, layout=narrow)
    epv_field = widgets.FloatText(value=20, description="epv_ridge_limit:",
                                  style=w, layout=narrow)
    C_field = widgets.Text(value="100, 30, 10, 3, 1, 0.3, 0.1",
                           description="C_candidates:", style=w, layout=wide)
    sep_field = widgets.FloatText(value=10.0, description="separation_limit:",
                                  style=w, layout=narrow)
    min_auto = widgets.Checkbox(
        value=True, indent=False,
        description="min_count automatic: max(100, 0.5 percent of rows in window)")
    min_field = widgets.IntText(value=100, description="min_count:", style=w,
                                layout=narrow, disabled=True)
    other_field = widgets.Text(value="OTHER", description="other_label:",
                               style=w, layout=narrow)
    share_field = widgets.FloatText(value=0.05, description="flag_share:",
                                    style=w, layout=narrow)
    thresh_field = widgets.Text(value="", placeholder="empty = None, use flag_share",
                                description="p_threshold (may be None):", style=w, layout=wide)
    n_imp_field = widgets.IntText(value=20, description="n_imputations:",
                                  style=w, layout=narrow)
    mar_field = widgets.FloatText(value=10.0, description="mar_limit_pp:",
                                  style=w, layout=narrow)
    n_boot_field = widgets.IntText(value=1000, description="n_bootstrap:",
                                   style=w, layout=narrow)
    reselect_box = widgets.Checkbox(value=False, indent=False,
                                    description="bootstrap_reselect (slow)")
    seed_field = widgets.IntText(value=42, description="seed:", style=w, layout=narrow)
    save_field = widgets.Text(value="", placeholder="empty = do not save",
                              description="save_dir (may be None):", style=w, layout=wide)

    # predicted Y per row
    pred_name_field = widgets.Text(value="predicted_Y", description="prediction_col:",
                                   style=w, layout=narrow)
    pred_all_box = widgets.Checkbox(
        value=True, indent=False,
        description="predict_all_rows (off: target period only)")
    pred_probs_box = widgets.Checkbox(
        value=False, indent=False,
        description="prediction_all_probs (one column per Y level)")

    def min_auto_changed(change):
        min_field.disabled = bool(change["new"])
    min_auto.observe(min_auto_changed, names="value")

    advanced_content = widgets.VBox([
        widgets.HTML("<b>Model choice</b>"),
        n_val_field, decay_field, decay_gain_field, epv_field, C_field, sep_field,
        widgets.HTML("<b>Y handling</b>"),
        min_auto, min_field, other_field,
        widgets.HTML("<b>Checks and imputation</b>"),
        share_field, thresh_field, n_imp_field, mar_field,
        widgets.HTML("<b>Bootstrap</b>"),
        n_boot_field, reselect_box, seed_field,
        widgets.HTML("<b>Predicted Y per row</b>"),
        pred_name_field, pred_all_box, pred_probs_box,
        widgets.HTML("<small>Gives each row the most likely Y, its probability, "
                     "the probability of the reported Y, and the role of the row "
                     "(target, holdout, development). Rows in the window are in "
                     "sample and count as diagnostics.</small>"),
        widgets.HTML("<b>Saving</b>"),
        save_field,
    ])
    advanced = widgets.Accordion(children=[advanced_content])
    advanced.set_title(0, "Advanced settings")
    advanced.selected_index = None

    run_btn = widgets.Button(description="Run model", button_style="success",
                             layout=widgets.Layout(width="200px"))
    out = widgets.Output()

    last_set = {}   # defaults set by fill(), to see if the user changed them

    def fill():
        old_types = {x: m.value for x, m in x_type_menus.items()}
        old_log = set(log_menu.value)
        for m in x_type_menus.values():
            m.close()
        x_type_menus.clear()
        if state["filtered"] is None or state["selection"] is None:
            y_html.value = "Run 'Apply and filter' in step 2 first."
            for m in (id_menu, date_menu, year_menu, sub_menu, month_menu):
                m.options = [(none, None)]
            x_type_box.children = []
            log_menu.options = []
            return
        d, y, xs = state["filtered"], state["selection"]["y"], state["selection"]["xs"]
        y_html.value = f"y_col: <b>{y}</b> (from step 2)"
        cols = list(d.columns)
        options = [(none, None)] + [(str(c), c) for c in cols]
        for m in (id_menu, date_menu, year_menu, sub_menu, month_menu):
            old = m.value
            m.options = options
            m.value = old if old in cols else None
        # suggest date and year column the first time; can be changed
        date_guess = next((c for c in cols
                           if pd.api.types.is_datetime64_any_dtype(d[c])), None)
        year_guess = next((c for c in cols
                           if str(c).lower() in ("year", "aar", "ar", "\u00e5r")), None)
        if date_menu.value is None and year_menu.value is None:
            date_menu.value = date_guess
            year_menu.value = year_guess
        years = None
        if date_guess is not None:
            years = d[date_guess].dt.year.dropna()
        elif year_guess is not None:
            years = _as_float(d[year_guess]).dropna()
        if years is not None and len(years):
            guess = {"target_year": int(years.max()),
                     "train_to_year": int(years.max()) - 1,
                     "train_from_year": int(years.min())}
            for name, field in (("target_year", target_year_field),
                                ("train_to_year", to_field),
                                ("train_from_year", from_field)):
                # only overwrite if the user has not changed the field
                if name not in last_set or field.value == last_set[name]:
                    field.value = guess[name]
                    last_set[name] = guess[name]
        rows = [widgets.HTML("<b>X columns from step 2: numeric or categorical</b>")]
        for x in xs:
            m = widgets.Dropdown(
                options=["numeric", "categorical"],
                value=old_types.get(x, "numeric" if _is_num(d[x]) else "categorical"),
                layout=widgets.Layout(width="140px"))
            x_type_menus[x] = m
            rows.append(widgets.HBox([
                widgets.Label(str(x), layout=widgets.Layout(width="200px")), m]))
        x_type_box.children = rows
        log_menu.options = [(str(x), x) for x in xs]
        log_menu.value = tuple(x for x in xs if x in old_log)

    def number_list(text, name):
        try:
            return [float(v) for v in text.split(",") if v.strip()]
        except ValueError:
            raise ValueError(f"{name}: write numbers separated by commas.")

    def read_settings():
        x_num = [x for x, m in x_type_menus.items() if m.value == "numeric"]
        x_cat = [x for x, m in x_type_menus.items() if m.value == "categorical"]
        decays = number_list(decay_field.value, "decay_candidates")
        Cs = number_list(C_field.value, "C_candidates")
        if not decays:
            raise ValueError("decay_candidates cannot be empty.")
        if not Cs:
            raise ValueError("C_candidates cannot be empty.")
        thresh = thresh_field.value.strip()
        return {
            "y_col": state["selection"]["y"],
            "id_col": id_menu.value,
            "time_source": source_menu.value,
            "date_col": date_menu.value,
            "date_format": date_fmt_field.value.strip() or None,
            "year_col": year_menu.value,
            "subperiod_col": sub_menu.value,
            "month_col": month_menu.value,
            "x_numeric": x_num,
            "x_categorical": x_cat,
            "log_cols": list(log_menu.value),
            "season_as_x": season_box.value,
            "frequency": freq_menu.value,
            "target_year": target_year_field.value,
            "target_subperiod": target_sub_field.value,
            "train_from_year": from_field.value,
            "train_to_year": to_field.value,
            "holdout_periods": holdout_field.value,
            "n_validation": n_val_field.value,
            "decay_candidates": decays,
            "decay_min_gain": decay_gain_field.value,
            "epv_ridge_limit": epv_field.value,
            "C_candidates": Cs,
            "separation_limit": sep_field.value,
            "min_count": None if min_auto.value else min_field.value,
            "other_label": other_field.value.strip() or "OTHER",
            "flag_share": share_field.value,
            "p_threshold": float(thresh) if thresh else None,
            "n_imputations": n_imp_field.value,
            "mar_limit_pp": mar_field.value,
            "n_bootstrap": n_boot_field.value,
            "bootstrap_reselect": reselect_box.value,
            "seed": seed_field.value,
            "save_dir": save_field.value.strip() or None,
            "prediction_col": pred_name_field.value.strip() or "predicted_Y",
            "predict_all_rows": pred_all_box.value,
            "prediction_all_probs": pred_probs_box.value,
        }

    def run(b):
        with out:
            clear_output()
            if state["filtered"] is None or state["selection"] is None:
                print("Run 'Apply and filter' in step 2 first.")
                return
            try:
                s = read_settings()
            except ValueError as e:
                print(f"Settings error: {e}")
                return
            v = state["selection"]
            print("Data from step 2:")
            print(f"  {v['rows_before']} rows before filtering, {v['rows_after']} after.")
            if v["filters"]:
                print("  Active filters:")
                for f in v["filters"]:
                    print(f"    {f}")
                print("  The model only covers the rows left after filtering.")
            else:
                print("  No active filters.")
            print(f"  x_numeric = {s['x_numeric']}")
            print(f"  x_categorical = {s['x_categorical']}")
            print(f"  log_cols = {s['log_cols']}\n")
            state["settings"] = s
            state["predicted"] = None
            try:
                state["result"] = fit_multinomial(state["filtered"], s)
            except ValueError as e:
                print(f"\nStopped: {e}")
                return
            except Exception as e:
                print(f"\nUnexpected error: {e}")
                traceback.print_exc()
                return
            print("\nDone. Results are in state['result'].")
            try:
                state["predicted"] = attach_predictions(state["filtered"], state["result"])
                new = list(state["result"]["predictions"].columns)
                print(f"Data with predicted Y is in state['predicted'] "
                      f"({len(new)} new columns: {new[0]} ...).")
                print("  For predictions on the unfiltered data: "
                      "attach_predictions(state['raw'], state['result'])")
            except ValueError as e:
                print(f"Could not join predictions to the data: {e}")

    run_btn.on_click(run)
    state["_callbacks"]["filtered"]["model"] = fill
    fill()

    state["widgets"]["model"] = {
        "id_col": id_menu, "time_source": source_menu, "date_col": date_menu,
        "date_format": date_fmt_field, "year_col": year_menu,
        "subperiod_col": sub_menu, "month_col": month_menu,
        "x_type": x_type_menus, "log_cols": log_menu, "season_as_x": season_box,
        "frequency": freq_menu, "target_year": target_year_field,
        "target_subperiod": target_sub_field, "train_from_year": from_field,
        "train_to_year": to_field, "holdout_periods": holdout_field,
        "n_validation": n_val_field, "decay_candidates": decay_field,
        "decay_min_gain": decay_gain_field, "epv_ridge_limit": epv_field,
        "C_candidates": C_field, "separation_limit": sep_field,
        "min_count_auto": min_auto, "min_count": min_field, "other_label": other_field,
        "flag_share": share_field, "p_threshold": thresh_field,
        "n_imputations": n_imp_field, "mar_limit_pp": mar_field,
        "n_bootstrap": n_boot_field, "bootstrap_reselect": reselect_box,
        "seed": seed_field, "save_dir": save_field,
        "prediction_col": pred_name_field, "predict_all_rows": pred_all_box,
        "prediction_all_probs": pred_probs_box,
        "run": run_btn, "output": out,
        "read_settings": read_settings,
    }

    display(widgets.VBox([
        widgets.HTML("<b>Step 4: multinomial logit, checks, imputation and bootstrap</b>"),
        y_html,
        widgets.HTML("<b>Columns</b>"),
        id_menu,
        widgets.HTML("<b>Time</b> (say which time columns exist; frequency is "
                     "picked below)"),
        source_menu, date_menu, date_fmt_field, year_menu, sub_menu, month_menu,
        widgets.HTML("<b>X</b>"),
        x_type_box, log_menu, season_box,
        widgets.HTML("<b>Periods</b>"),
        freq_menu, target_year_field, target_sub_field, from_field, to_field,
        holdout_field,
        advanced,
        run_btn, out,
    ]))
