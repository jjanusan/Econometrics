GCS_PROJECT = None


# ---- Small helpers ----------------------------------------------------------

def _run_callbacks(state, name):
    """Runs the update functions that later steps registered."""
    for f in state["_callbacks"].get(name, {}).values():
        f()


def _is_num(series):
    dtype = series.dtype
    return (pd.api.types.is_numeric_dtype(dtype)
            and not pd.api.types.is_bool_dtype(dtype)
            and not pd.api.types.is_complex_dtype(dtype)
            and not isinstance(dtype, pd.CategoricalDtype))


def _is_cat(series):
    dtype = series.dtype
    return (isinstance(dtype, pd.CategoricalDtype)
            or pd.api.types.is_bool_dtype(dtype)
            or pd.api.types.is_object_dtype(dtype)
            or pd.api.types.is_string_dtype(dtype))


def _as_float(series):
    """Column as float64. Anything that is not a number becomes NaN."""
    return pd.to_numeric(series, errors="coerce").astype("float64")


def _parse_const(text, kind):
    """Turns the text from a field into the right type for a constant column."""
    text = text.strip()
    if text == "":
        raise ValueError("the value is empty")
    if kind == "integer":
        return int(text)
    if kind == "decimal":
        return float(text.replace(",", "."))
    if kind == "date":
        return pd.Timestamp(text)
    return text


# ---- Reading: local folder or Google Cloud Storage --------------------------

_gcs = None


def get_gcs():
    """Creates the gcsfs file system the first time it is needed."""
    global _gcs
    if _gcs is None:
        import gcsfs
        kwargs = {"token": "google_default"}
        if GCS_PROJECT:
            kwargs["project"] = GCS_PROJECT
        _gcs = gcsfs.GCSFileSystem(**kwargs)
    return _gcs


def is_gcs(path):
    """True for gs:// paths, False for local paths."""
    return str(path).startswith("gs://")


def _strip_gs(path):
    return str(path)[len("gs://"):]


def list_dir(path):
    """
    Lists content as [{"name":..., "path":..., "is_dir": True/False}],
    folders first. "gs://" lists the buckets you have access to.
    """
    out = []
    if is_gcs(path):
        for item in get_gcs().ls(_strip_gs(path), detail=True):
            name = item["name"].rstrip("/")
            out.append({
                "name": name.split("/")[-1],
                "path": "gs://" + name,
                "is_dir": item["type"] == "directory",
            })
    else:
        for name in os.listdir(path):
            if name.startswith("."):
                continue
            full = os.path.join(path, name)
            out.append({"name": name, "path": full, "is_dir": os.path.isdir(full)})
    return sorted(out, key=lambda e: (not e["is_dir"], e["name"]))


def read_table(path):
    """Reads parquet or csv from a local folder or from GCS."""
    if is_gcs(path):
        fs = get_gcs()
        if path.endswith(".parquet"):
            with fs.open(path, "rb") as f:
                return pd.read_parquet(f)
        if path.endswith(".csv"):
            with fs.open(path, "r") as f:
                return pd.read_csv(f)
    else:
        if path.endswith(".parquet"):
            return pd.read_parquet(path)
        if path.endswith(".csv"):
            return pd.read_csv(path)
    raise ValueError(f"Only .parquet and .csv are supported, got: {path}")


def combine_frames(frames, method="concat", key=None):
    """Stacks rows (concat) or joins on a shared column (merge)."""
    if len(frames) == 1:
        return frames[0].copy()
    if method == "concat":
        return pd.concat(frames, ignore_index=True)
    out = frames[0]
    for f in frames[1:]:
        out = out.merge(f, on=key, how="inner")
    return out


# ---- Step 1: load ------------------------------------------------------------

def step_load(start_path=".", df=None):
    """
    Step 1: file browser. Click through folders, pick one or more files
    (.parquet / .csv), combine and load.

    start_path: local folder, or "gs://bucket/folder" for Google Cloud Storage.
                "gs://" lists your buckets.
    df:         skip the browser and use this data frame directly.

    Constant column per file: type a column name and pick a type. Each picked
    file gets its own value field. The value is put on every row of that file
    before the files are combined. A file without a value gets an empty value.
    Empty column name means no constant column.

    Returns state, which the other steps take as input.
    """
    state = {
        "path": start_path, "selected_files": [], "raw_list": [], "raw_paths": [],
        "raw": None, "filtered": None, "selection": None, "diagnostics": None,
        "result": None, "predicted": None, "aggregate": None,
        "x_values": {}, "x_ranges": {},
        "const_values": {},
        "_callbacks": {"raw": {}, "filtered": {}},
        "widgets": {},
    }

    w90 = {"description_width": "90px"}
    const_name = widgets.Text(value="", placeholder="empty = no constant column",
                              description="Const column:", style=w90,
                              layout=widgets.Layout(width="300px"))
    const_kind = widgets.Dropdown(options=["integer", "decimal", "text", "date"],
                                  value="integer", description="Type:", style=w90,
                                  layout=widgets.Layout(width="300px"))

    # Data frame given directly: one data frame, one value.
    if df is not None:
        state["raw"] = df.copy()
        print(f"Data frame given directly: {df.shape[0]} rows, {df.shape[1]} columns")
        const_value = widgets.Text(value="", placeholder="e.g. 2025 or 2025-01-01",
                                   description="Value:", style=w90,
                                   layout=widgets.Layout(width="300px"))
        add_btn = widgets.Button(description="Add column", button_style="success",
                                 layout=widgets.Layout(width="200px"))
        add_out = widgets.Output()

        def add_column(b):
            changed = False
            with add_out:
                clear_output()
                name = const_name.value.strip()
                if not name:
                    print("Type a column name.")
                    return
                try:
                    value = _parse_const(const_value.value, const_kind.value)
                except ValueError as e:
                    print(f"Could not read the value as {const_kind.value}: {e}")
                    return
                if name in state["raw"].columns:
                    print(f"WARNING: {name} already exists and is overwritten.")
                state["raw"][name] = value
                state["filtered"] = None
                state["selection"] = None
                print(f"{name} = {value!r} added to all {len(state['raw'])} rows.")
                print("Choices in step 2 are reset. Pick Y and X again.")
                changed = True
            if changed:
                _run_callbacks(state, "raw")

        add_btn.on_click(add_column)
        display(widgets.VBox([
            widgets.HTML("<b>Constant column (optional)</b>"),
            const_name, const_kind, const_value, add_btn, add_out,
        ]))
        return state

    path_label = widgets.Label(value=str(start_path))
    up_btn = widgets.Button(description="Up", button_style="warning",
                            layout=widgets.Layout(width="100px"))
    status_label = widgets.Label(value="")
    browser_out = widgets.Output()
    picked_out = widgets.Output()
    method_menu = widgets.Dropdown(
        options=[("Stack rows (concat)", "concat"),
                 ("Join on shared column (merge)", "merge")],
        value="concat", description="Combine:",
        style=w90, layout=widgets.Layout(width="360px"))
    key_menu = widgets.Dropdown(
        options=[("(pick key)", None)], value=None, description="Key:",
        disabled=True, style=w90, layout=widgets.Layout(width="300px"))
    load_btn = widgets.Button(description="Load picked files", button_style="success",
                              layout=widgets.Layout(width="200px"))
    load_out = widgets.Output()

    def make_click(item):
        def click(b):
            if item["is_dir"]:
                state["path"] = item["path"]
                refresh_browser()
            else:
                if item["path"] not in state["selected_files"]:
                    state["selected_files"].append(item["path"])
                refresh_picked()
                status_label.value = f"Picked: {item['name']}"
        return click

    def refresh_browser():
        path_label.value = str(state["path"])
        with browser_out:
            clear_output(wait=True)
            try:
                content = list_dir(state["path"])
                status_label.value = ""
            except Exception as e:
                status_label.value = f"Could not list {state['path']}: {e}"
                content = []
            buttons = []
            for item in content:
                btn = widgets.Button(
                    description=("/ " if item["is_dir"] else "* ") + item["name"],
                    button_style="info" if item["is_dir"] else "",
                    layout=widgets.Layout(width="100%"))
                btn.on_click(make_click(item))
                buttons.append(btn)
            display(widgets.VBox(buttons) if buttons else widgets.Label("(empty folder)"))

    def make_remove_btn(file_path):
        btn = widgets.Button(description="X", button_style="danger",
                             layout=widgets.Layout(width="40px"))

        def remove(b):
            state["selected_files"].remove(file_path)
            state["const_values"].pop(file_path, None)
            refresh_picked()
        btn.on_click(remove)
        return btn

    def make_value_field(file_path):
        field = widgets.Text(value=state["const_values"].get(file_path, ""),
                             placeholder="constant value",
                             layout=widgets.Layout(width="160px"))

        def changed(change):
            state["const_values"][file_path] = change["new"]
        field.observe(changed, names="value")
        return field

    def refresh_picked():
        with picked_out:
            clear_output(wait=True)
            if not state["selected_files"]:
                display(widgets.Label("No files picked"))
                return
            rows = [widgets.HBox([widgets.Label(value=f,
                                                layout=widgets.Layout(flex="1")),
                                  make_value_field(f),
                                  make_remove_btn(f)])
                    for f in state["selected_files"]]
            display(widgets.VBox(
                [widgets.Label("Picked files (the field on the right is the "
                               "constant column value for that file):")] + rows))

    def go_up(b):
        if is_gcs(state["path"]):
            rest = _strip_gs(state["path"]).rstrip("/")
            state["path"] = "gs://" + (rest.rsplit("/", 1)[0] if "/" in rest else "")
        else:
            state["path"] = os.path.dirname(os.path.abspath(str(state["path"])))
        refresh_browser()

    def load(b):
        loaded = False
        with load_out:
            clear_output()
            if not state["selected_files"]:
                print("Pick at least one file first.")
                return
            if state["raw_list"] and state["raw_paths"] == list(state["selected_files"]):
                frames = state["raw_list"]
            else:
                frames = []
                for path in state["selected_files"]:
                    try:
                        f = read_table(path)
                    except Exception as e:
                        print(f"Error reading {path}: {e}")
                        return
                    print(f"{path}: {f.shape[0]} rows, {f.shape[1]} columns")
                    frames.append(f)
                state["raw_list"] = frames
                state["raw_paths"] = list(state["selected_files"])

            # Constant column per file. Added to copies, so the raw data stay unchanged.
            name = const_name.value.strip()
            has_values = any(state["const_values"].get(p, "").strip()
                             for p in state["selected_files"])
            if not name and has_values:
                print("NOTE: values are filled in, but the column name is empty. "
                      "No constant column added.")
            if name:
                empty = pd.NaT if const_kind.value == "date" else np.nan
                with_const = []
                for path, f in zip(state["selected_files"], frames):
                    f = f.copy()
                    text = state["const_values"].get(path, "").strip()
                    if name in f.columns:
                        print(f"WARNING: {name} already exists in {path} and is overwritten.")
                    if text == "":
                        f[name] = empty
                        print(f"NOTE: {path} has no value, {name} will be empty.")
                    else:
                        try:
                            value = _parse_const(text, const_kind.value)
                        except ValueError as e:
                            print(f"Could not read '{text}' as {const_kind.value} "
                                  f"for {path}: {e}")
                            return
                        f[name] = value
                        print(f"{path}: {name} = {value!r}")
                    with_const.append(f)
                frames = with_const

            shared = set(frames[0].columns)
            for f in frames[1:]:
                shared &= set(f.columns)
            shared = sorted(shared)
            old = key_menu.value
            key_menu.options = [("(pick key)", None)] + [(c, c) for c in shared]
            key_menu.value = old if old in shared else None
            key_menu.disabled = len(frames) < 2
            if len(frames) > 1:
                print(f"Shared columns: {shared}")

            if method_menu.value == "merge" and len(frames) > 1:
                if key_menu.value is None:
                    print("Pick a key for merge and press 'Load picked files' again.")
                    return
                if name and name != key_menu.value:
                    print(f"NOTE: {name} is in every file and is not the key. "
                          f"Merge then gives several columns ({name}_x, {name}_y). "
                          "Use concat if the files are different periods.")
                state["raw"] = combine_frames(frames, "merge", key_menu.value)
            else:
                state["raw"] = combine_frames(frames, "concat")
            state["filtered"] = None
            state["selection"] = None
            print(f"Combined data: {state['raw'].shape[0]} rows, "
                  f"{state['raw'].shape[1]} columns")
            if name and name in state["raw"].columns:
                print(f"Rows per value of {name}:")
                print(state["raw"][name].value_counts(dropna=False).sort_index()
                      .to_string())
            print("Go on to step 2.")
            loaded = True
        if loaded:
            _run_callbacks(state, "raw")

    step1 = widgets.VBox([
        widgets.HTML("<b>Step 1: browse and pick files (.parquet / .csv)</b>"),
        widgets.HBox([up_btn, path_label, status_label]),
        browser_out,
        widgets.HTML("<hr>"),
        widgets.HBox([const_name, const_kind]),
        widgets.HTML("<small>Constant column: type name and type here, and one "
                     "value per file in the list below. The value is added when "
                     "you press 'Load picked files'. If you change a value, press "
                     "the button again.</small>"),
        picked_out,
        widgets.HBox([method_menu, key_menu]),
        load_btn,
        load_out,
    ])
    up_btn.on_click(go_up)
    load_btn.on_click(load)

    state["widgets"]["load"] = {
        "method": method_menu, "key": key_menu, "load": load_btn,
        "up": up_btn, "const_name": const_name, "const_kind": const_kind,
    }
    refresh_browser()
    refresh_picked()
    display(step1)
    return state


# ---- Step 1b: column overview and sums ---------------------------------------

def _describe_numeric(x):
    """Descriptive statistics for a numeric column, as one row."""
    x_clean = x.dropna()
    if x_clean.empty:
        return pd.DataFrame([{"N": 0, "Missing": int(x.isna().sum())}])
    q1, q3 = x_clean.quantile([0.25, 0.75])
    row = {
        "N": len(x_clean),
        "Missing": int(x.isna().sum()),
        "Mean": x_clean.mean(),
        "SD": x_clean.std(),
        "Median": x_clean.median(),
        "Q1": q1,
        "Q3": q3,
        "Min": x_clean.min(),
        "Max": x_clean.max(),
        "IQR": q3 - q1,
        "Skewness": x_clean.skew(),
        "Unique values": x_clean.nunique(),
    }
    return pd.DataFrame([row])


def _describe_numeric_by_group(df, column, group, max_groups=200):
    """Descriptive statistics for a numeric column, one row per value of group."""
    n = df[group].nunique(dropna=False)
    if n > max_groups:
        raise ValueError(f"{group} has {n} values, the limit is {max_groups}. "
                         "Pick a grouping column with fewer values.")
    parts = []
    for value, g in df.groupby(group, dropna=False, observed=True, sort=False):
        row = _describe_numeric(g[column])
        row.insert(0, group, value)
        parts.append(row)
    out = pd.concat(parts, ignore_index=True)
    try:
        out = out.sort_values(group, na_position="last", ignore_index=True)
    except TypeError:
        pass
    return out


def _describe_categorical(x, max_rows=50):
    """Frequency table for a categorical column."""
    freq = (x.value_counts(dropna=False)
            .rename_axis("Category")
            .reset_index(name="N"))
    freq["Percent"] = (freq["N"] / len(x) * 100).round(1)
    if len(freq) > max_rows:
        rest = freq.iloc[max_rows:]
        freq = freq.iloc[:max_rows].copy()
        freq.loc[len(freq)] = [f"(+{len(rest)} more levels)",
                               int(rest["N"].sum()),
                               round(rest["Percent"].sum(), 1)]
    return freq


def _describe_datetime(x):
    """Summary for a date column: span, days, years and months."""
    x_clean = x.dropna()
    if x_clean.empty:
        return pd.DataFrame([{"N": 0, "Missing": int(x.isna().sum())}])
    return pd.DataFrame([{
        "N": len(x_clean),
        "Missing": int(x.isna().sum()),
        "Min": x_clean.min(),
        "Max": x_clean.max(),
        "Span (days)": (x_clean.max() - x_clean.min()).days,
        "Unique dates": x_clean.nunique(),
        "Unique years": x_clean.dt.year.nunique(),
        "Unique months": x_clean.dt.to_period("M").nunique(),
    }])


def inspect_column(df, column):
    """Prints type, count and missing, and returns a summary table."""
    x = df[column]
    print(f"\nColumn: {column}")
    print(f"Type: {x.dtype}")
    print(f"Observations: {len(x)}")
    print(f"Missing: {int(x.isna().sum())} ({100 * x.isna().mean():.1f} percent)")
    if pd.api.types.is_datetime64_any_dtype(x):
        return _describe_datetime(x)
    if pd.api.types.is_numeric_dtype(x) and not pd.api.types.is_bool_dtype(x):
        return _describe_numeric(x)
    print(f"Unique values: {x.nunique(dropna=True)}")
    return _describe_categorical(x)


def browse_columns(df):
    """Column browser with a dropdown. Takes a data frame directly."""
    dropdown = widgets.Dropdown(
        options=df.columns.tolist(),
        description="Column:",
        style={"description_width": "initial"},
    )
    output = widgets.Output()

    def on_change(change):
        if change["type"] == "change" and change["name"] == "value":
            with output:
                clear_output(wait=True)
                display(inspect_column(df, change["new"]))

    dropdown.observe(on_change, names="value")
    display(dropdown, output)
    with output:
        display(inspect_column(df, dropdown.value))
    return dropdown, output


def sum_by(df, column, value_col, time_col=None, where_col=None, where_value=None,
           max_rows=500):
    """
    Sum of value_col per value of column, optionally split by time_col.
    Same as in SQL:
        SELECT column, time_col, SUM(value_col) FROM df
        WHERE where_col = where_value
        GROUP BY column, time_col
    Empty values in value_col are skipped. A cell with no numbers becomes NaN.
    Returns (table, rows used).
    """
    if value_col == column:
        raise ValueError("Pick a different column to sum than the column itself.")
    if time_col is not None and time_col in (column, value_col):
        raise ValueError("The time column must differ from column and value column.")
    d = df
    if where_col is not None:
        d = d[d[where_col] == where_value]
        if d.empty:
            raise ValueError(f"No rows where {where_col} = {where_value!r}.")
    n = d[column].nunique(dropna=False)
    if n > max_rows:
        raise ValueError(f"{column} has {n} values, the limit is {max_rows}. "
                         "Pick a column with fewer values or narrow with WHERE.")
    keys = [column] if time_col is None else [column, time_col]
    small = d[keys].copy()
    small["_sum"] = _as_float(d[value_col])
    g = small.groupby(keys, dropna=False, observed=True)["_sum"].sum(min_count=1)
    if time_col is None:
        table = g.to_frame(f"sum_{value_col}")
    else:
        table = g.unstack(time_col)
        table.columns = table.columns.astype(object)
        table["Total"] = table.sum(axis=1, min_count=1)
    table.index = table.index.astype(object)
    table.loc["Total"] = table.sum(min_count=1)
    return table, len(d)


def step_explore(state):
    """
    Step 1b: look at one column at a time, and sum a numeric column per
    value of that column.

    Column:    the column you look at and group by.
    Sum:       numeric column summed per value of Column.
    Split by:  time column (for example the constant column from step 1).
               Gives one table column per time value.
    WHERE:     limit rows to those where a column has a given value.

    Does not change the data. The filter here only applies to step 1b.
    The last table is stored in state["aggregate"].
    """
    w = {"description_width": "90px"}
    wide = widgets.Layout(width="330px")
    column_menu = widgets.Dropdown(options=[], description="Column:",
                                   style=w, layout=wide)
    sum_menu = widgets.Dropdown(options=[("(none)", None)], value=None,
                                description="Sum:", style=w, layout=wide)
    time_menu = widgets.Dropdown(options=[("(none)", None)], value=None,
                                 description="Split by:", style=w, layout=wide)
    where_col = widgets.Dropdown(options=[("(none)", None)], value=None,
                                 description="WHERE:", style=w, layout=wide)
    where_value = widgets.Dropdown(options=[("(pick column)", None)], value=None,
                                   description="=", disabled=True,
                                   style=w, layout=wide)
    output = widgets.Output()
    ui = {"loading": False, "first": True}

    def show():
        with output:
            clear_output(wait=True)
            if state["raw"] is None:
                print("Load data first (step 1).")
                return
            name = column_menu.value
            if name is None:
                print("Pick a column.")
                return
            d = state["raw"]
            if where_col.value is not None:
                if where_value.value is None:
                    print(f"WHERE {where_col.value}: no value picked, filter not used.")
                else:
                    d = d[d[where_col.value] == where_value.value]
                    print(f"WHERE {where_col.value} = {where_value.value!r}: "
                          f"{len(d)} of {len(state['raw'])} rows.")
            if d.empty:
                print("No rows left after the filter.")
                return
            display(inspect_column(d, name))
            if sum_menu.value is None:
                return
            text = f"\nSum of {sum_menu.value} per {name}"
            if time_menu.value is not None:
                text += f", split by {time_menu.value}"
            print(text + ":")
            try:
                table, n = sum_by(d, name, sum_menu.value, time_col=time_menu.value)
            except ValueError as e:
                print(f"Stopped: {e}")
                return
            state["aggregate"] = table
            display(table.round(0).astype("Int64"))
            print("NaN means the cell has no rows, or only empty values in "
                  f"{sum_menu.value}.")

    def fill_where_values():
        col = where_col.value
        ui["loading"] = True
        try:
            if col is None or state["raw"] is None:
                where_value.options = [("(pick column)", None)]
                where_value.value = None
                where_value.disabled = True
            else:
                series = state["raw"][col].dropna().drop_duplicates()
                if len(series) > 1000:
                    where_value.options = [(f"(too many values: {len(series)})", None)]
                    where_value.value = None
                    where_value.disabled = True
                else:
                    try:
                        values = series.sort_values().tolist()
                    except TypeError:
                        values = sorted(series.tolist(), key=str)
                    values = [v.item() if isinstance(v, np.generic) else v
                              for v in values]
                    where_value.options = [(str(v), v) for v in values] or [
                        ("(no values)", None)]
                    where_value.value = values[0] if values else None
                    where_value.disabled = not values
        finally:
            ui["loading"] = False

    def on_change(change):
        if not ui["loading"]:
            show()

    def on_where_col(change):
        if ui["loading"]:
            return
        fill_where_values()
        show()

    def fill():
        ui["loading"] = True
        try:
            if state["raw"] is None:
                column_menu.options = []
                column_menu.value = None
                for m in (sum_menu, time_menu, where_col):
                    m.options = [("(none)", None)]
                    m.value = None
            else:
                d = state["raw"]
                cols = list(d.columns)
                old = column_menu.value
                column_menu.options = [(str(c), c) for c in cols]
                column_menu.value = old if old in cols else (cols[0] if cols else None)

                numeric = [c for c in cols if _is_num(d[c])]
                old = sum_menu.value
                sum_menu.options = [("(none)", None)] + [(str(c), c) for c in numeric]
                sum_menu.value = old if old in numeric else None

                old = time_menu.value
                time_menu.options = [("(none)", None)] + [(str(c), c) for c in cols]
                if old in cols:
                    time_menu.value = old
                elif ui["first"]:
                    # Suggestion: constant column from step 1, else a column named year.
                    const = state["widgets"].get("load", {}).get("const_name")
                    const = const.value.strip() if const is not None else ""
                    guess = const if const in cols else next(
                        (c for c in cols
                         if str(c).lower() in ("year", "aar", "ar", "\u00e5r")), None)
                    time_menu.value = guess
                else:
                    time_menu.value = None

                old = where_col.value
                where_col.options = [("(none)", None)] + [(str(c), c) for c in cols]
                where_col.value = old if old in cols else None
                ui["first"] = False
        finally:
            ui["loading"] = False
        fill_where_values()
        show()

    for m in (column_menu, sum_menu, time_menu, where_value):
        m.observe(on_change, names="value")
    where_col.observe(on_where_col, names="value")
    state["_callbacks"]["raw"]["explore"] = fill
    state["widgets"]["explore"] = {
        "column": column_menu, "sum": sum_menu, "time": time_menu,
        "where_col": where_col, "where_value": where_value, "output": output,
    }
    display(widgets.VBox([
        widgets.HTML("<b>Step 1b: column overview and sums</b>"),
        widgets.HTML("<small>Pick Column to inspect it. Also pick a column under "
                     "Sum to get the sum per value of Column. Split by gives one "
                     "table column per time value. WHERE limits the rows, like "
                     "WHERE in SQL. The data are not changed.</small>"),
        widgets.HBox([column_menu, sum_menu]),
        widgets.HBox([time_menu]),
        widgets.HBox([where_col, where_value]),
        output,
    ]))
    fill()


# ---- Step 2: pick columns and filter ------------------------------------------

def step_select(state):
    """
    Step 2: pick Y (categorical target), X (predictors) and filter rows on
    chosen X values.

    Categorical X: tick values in the X values panel. Only rows with a ticked
    value, or an empty value, are kept. No ticked values means no filter on
    that column.
    Numeric X: an active range keeps rows within both limits, plus rows with
    an empty value. Without an active range all rows are kept.
    Bool and pandas category are treated as categorical, even with numbers.

    Y is never filtered directly. Y levels can only lose rows because X values
    were filtered out, and that is shown in the printout.

    No recoding here. Columns go on unchanged; dummy coding and log transforms
    happen in step 4.

    The button "Apply and filter" puts the filtered data in state["filtered"]
    and the choices in state["selection"]. If you change anything afterwards,
    press the button again before step 3 and 4.
    """
    w = {"description_width": "110px"}
    y_menu = widgets.Dropdown(options=[], description="Y (target):", style=w,
                              layout=widgets.Layout(width="330px"))
    x_checks = {}
    x_check_box = widgets.VBox()
    x_cache, x_ticked, x_visible = {}, {}, {}
    x_bounds = {}
    state["x_values"] = {}
    state["x_ranges"] = {}
    ui = {"loading": False, "syncing": False, "page": 0}
    page_size = 100

    x_active = widgets.Dropdown(
        options=[("(pick X)", None)], disabled=True,
        description="Column:", style={"description_width": "65px"},
        layout=widgets.Layout(width="290px"))
    x_search = widgets.Text(
        placeholder="Search X values...", disabled=True,
        layout=widgets.Layout(width="290px"))
    x_value_box = widgets.VBox(
        layout=widgets.Layout(width="100%", height="180px",
                              border="1px solid gray", overflow="auto",
                              align_items="stretch"))
    x_all_btn = widgets.Button(description="Select all", disabled=True,
                               layout=widgets.Layout(width="100px"))
    x_clear_btn = widgets.Button(description="Clear", disabled=True,
                                 layout=widgets.Layout(width="100px"))
    x_status = widgets.Label(value="Pick an X column.")
    x_prev = widgets.Button(description="Prev", layout=widgets.Layout(width="80px"))
    x_next = widgets.Button(description="Next", layout=widgets.Layout(width="80px"))
    x_page = widgets.Label()
    x_pager = widgets.HBox([x_prev, x_page, x_next],
                           layout=widgets.Layout(display="none"))
    x_cat_panel = widgets.VBox([
        x_search,
        x_value_box,
        widgets.HBox([x_all_btn, x_clear_btn]), x_pager,
        widgets.HTML(
            "<small>Only rows with ticked values are kept. Nothing ticked "
            "means no filter. Select all also covers values hidden by the "
            "search.</small>")
    ], layout=widgets.Layout(width="290px", display="none"))

    x_use_range = widgets.Checkbox(
        value=False, description="Use range as filter", indent=False)
    x_lo = widgets.FloatText(
        value=0, description="From:", style={"description_width": "38px"},
        layout=widgets.Layout(width="140px"))
    x_hi = widgets.FloatText(
        value=1, description="To:", style={"description_width": "30px"},
        layout=widgets.Layout(width="140px"))
    x_slider = widgets.FloatRangeSlider(
        value=(0, 1), min=0, max=1, step=0.01, readout=False,
        continuous_update=False, layout=widgets.Layout(width="290px"))
    x_range_reset = widgets.Button(
        description="Reset range", layout=widgets.Layout(width="150px"))
    x_num_panel = widgets.VBox([
        x_use_range, widgets.HBox([x_lo, x_hi]), x_slider,
        x_range_reset,
        widgets.HTML(
            "<small>Type limits or drag the handles to turn the range on. "
            "Both limits are included. Rows outside the range are removed, "
            "rows with an empty value are kept. Untick to keep all rows. "
            "Write ten thousand as 10000.</small>")
    ], layout=widgets.Layout(width="290px", display="none"))

    apply_btn = widgets.Button(
        description="Apply and filter", button_style="info",
        layout=widgets.Layout(width="290px"))
    apply_out = widgets.Output()

    def reset_downstream(change=None):
        if ui["loading"]:
            return
        state["filtered"] = None
        state["selection"] = None

    def get_x_values(name):
        if name not in x_cache:
            series = state["raw"][name].dropna().drop_duplicates()
            try:
                values = series.sort_values().tolist()
            except TypeError:
                values = sorted(series.tolist(),
                                key=lambda v: (type(v).__name__, str(v).casefold()))
            values = [v.item() if isinstance(v, np.generic) else v for v in values]
            x_cache[name] = values
            x_ticked[name] = set()
            state["x_values"][name] = []
        return x_cache[name]

    def save_x_choice(name):
        state["x_values"][name] = [x_cache[name][i] for i in sorted(x_ticked[name])]
        reset_downstream()

    def is_num_x(name):
        return _is_num(state["raw"][name])

    def get_x_range(name):
        if name not in x_bounds:
            nums = _as_float(state["raw"][name])
            nums = nums[np.isfinite(nums)]
            x_bounds[name] = (None if nums.empty else
                              (float(nums.min()), float(nums.max())))
            lo, hi = x_bounds[name] or (0.0, 1.0)
            state["x_ranges"][name] = {"lo": lo, "hi": hi, "on": False}
        return state["x_ranges"][name]

    def range_error(r):
        if not np.isfinite(r["lo"]) or not np.isfinite(r["hi"]):
            return "From and To must be finite numbers."
        if r["lo"] > r["hi"]:
            return "From cannot be larger than To."
        return None

    def show_x_range(name):
        r = get_x_range(name)
        bounds = x_bounds[name]
        ui["syncing"] = True
        try:
            x_use_range.value = r["on"]
            x_lo.value = round(r["lo"], 2)
            x_hi.value = round(r["hi"], 2)
            for ctrl in (x_use_range, x_lo, x_hi, x_range_reset):
                ctrl.disabled = bounds is None
            err = range_error(r)
            x_slider.disabled = bounds is None or err is not None
            if bounds is not None and err is None:
                lower = min(bounds[0], r["lo"])
                upper = max(bounds[1], r["hi"])
                if lower == upper:
                    width = max(1.0, abs(lower) * 0.01)
                    lower, upper = lower - width, upper + width
                # Widen first to avoid invalid limits when switching X.
                x_slider.min = min(x_slider.min, lower)
                x_slider.max = max(x_slider.max, upper)
                x_slider.value = (r["lo"], r["hi"])
                x_slider.min, x_slider.max = lower, upper
                x_slider.step = (1.0 if pd.api.types.is_integer_dtype(
                    state["raw"][name].dtype) else max((upper - lower) / 1000, 1e-9))
        finally:
            ui["syncing"] = False

    def range_changed(change):
        if ui["loading"] or ui["syncing"]:
            return
        name = x_active.value
        if name is None or not is_num_x(name):
            return
        r = get_x_range(name)
        if change["owner"] is x_use_range:
            r["on"] = bool(change["new"])
        else:
            r["on"] = True
            if change["owner"] is x_slider:
                r["lo"], r["hi"] = map(float, change["new"])
            else:
                r["lo"], r["hi"] = float(x_lo.value), float(x_hi.value)
        reset_downstream()
        show_x_range(name)
        update_x_status()

    def reset_range(b):
        name = x_active.value
        if name is None or not is_num_x(name):
            return
        lo, hi = x_bounds[name] or (0.0, 1.0)
        state["x_ranges"][name] = {"lo": lo, "hi": hi, "on": False}
        reset_downstream()
        show_x_range(name)
        update_x_status()

    def update_x_status():
        name = x_active.value
        if name is None:
            x_status.value = "Pick an X column."
            x_all_btn.disabled = x_clear_btn.disabled = True
            return
        if is_num_x(name):
            x_all_btn.disabled = x_clear_btn.disabled = True
            r = get_x_range(name)
            if x_bounds[name] is None:
                x_status.value = "No finite numbers in the column."
            elif not r["on"]:
                x_status.value = "No filter: all rows kept."
            elif range_error(r):
                x_status.value = range_error(r)
            else:
                nums = _as_float(state["raw"][name])
                known = np.isfinite(nums)
                hits = nums.between(r["lo"], r["hi"], inclusive="both") & known
                empty = int(state["raw"][name].isna().sum())
                x_status.value = (f"Keeps {int(hits.sum())} of {int(known.sum())} "
                                  f"known, plus {empty} empty.")
            return
        values = get_x_values(name)
        text = x_search.value.casefold().strip()
        hits = sum(text in str(v).casefold() for v in values)
        n = len(x_ticked[name])
        if n == 0:
            x_status.value = f"No filter: all rows kept. {hits} search hits."
        else:
            x_status.value = f"{n} of {len(values)} values ticked; {hits} search hits."
        x_all_btn.disabled = not values
        x_clear_btn.disabled = not n

    def show_x_values():
        for box in x_visible.values():
            box.close()
        x_visible.clear()
        name = x_active.value
        numeric = name is not None and is_num_x(name)
        x_cat_panel.layout.display = "flex" if name is not None and not numeric else "none"
        x_num_panel.layout.display = "flex" if numeric else "none"
        x_search.disabled = name is None or numeric
        if name is None:
            x_value_box.children = [widgets.Label("Pick an X column.")]
            x_pager.layout.display = "none"
            update_x_status()
            return
        if numeric:
            x_value_box.children = []
            show_x_range(name)
            update_x_status()
            return
        values = get_x_values(name)
        text = x_search.value.casefold().strip()
        hits = [i for i, v in enumerate(values) if text in str(v).casefold()]
        pages = max(1, (len(hits) + page_size - 1) // page_size)
        ui["page"] = min(ui["page"], pages - 1)
        start = ui["page"] * page_size
        for i in hits[start:start + page_size]:
            box = widgets.Checkbox(
                value=i in x_ticked[name], description=str(values[i]),
                indent=False, layout=widgets.Layout(width="auto"))

            def ticked(change, col=name, idx=i):
                if change["new"]:
                    x_ticked[col].add(idx)
                else:
                    x_ticked[col].discard(idx)
                save_x_choice(col)
                update_x_status()

            box.observe(ticked, names="value")
            x_visible[i] = box
        x_value_box.children = list(x_visible.values()) or [
            widgets.Label("No hits." if values else "No values.")]
        x_page.value = f"{ui['page'] + 1} / {pages}"
        x_prev.disabled = ui["page"] == 0
        x_next.disabled = ui["page"] == pages - 1
        x_pager.layout.display = "flex" if pages > 1 else "none"
        update_x_status()

    def switch_x(change=None):
        if ui["loading"]:
            return
        ui["page"] = 0
        ui["syncing"] = True
        try:
            x_search.value = ""
        finally:
            ui["syncing"] = False
        show_x_values()

    def search_x(change):
        if ui["loading"] or ui["syncing"]:
            return
        ui["page"] = 0
        show_x_values()

    def move_page(step):
        ui["page"] = max(0, ui["page"] + step)
        show_x_values()

    def select_all_x(b):
        name = x_active.value
        if name is not None and not is_num_x(name):
            # All values, also those hidden by search or paging.
            x_ticked[name] = set(range(len(get_x_values(name))))
            save_x_choice(name)
            show_x_values()

    def clear_x(b):
        name = x_active.value
        if name is not None and not is_num_x(name):
            x_ticked[name].clear()
            save_x_choice(name)
            show_x_values()

    def update_x_list(change=None, col=None):
        if ui["loading"]:
            return
        chosen = [n for n, b in x_checks.items() if b.value and n != y_menu.value]
        old = x_active.value
        preferred = col if change and change["new"] else old
        x_active.options = [(str(n), n) for n in chosen] or [("(pick X)", None)]
        x_active.value = (preferred if preferred in chosen
                          else chosen[0] if chosen else None)
        x_active.disabled = not chosen
        switch_x()
        reset_downstream()

    def y_changed(change=None):
        if ui["loading"]:
            return
        for name, box in x_checks.items():
            box.disabled = name == y_menu.value
            if box.disabled:
                box.value = False
        update_x_list()

    def fill_menus():
        ui["loading"] = True
        try:
            cols = list(state["raw"].columns)
            y_menu.options = cols
            for box in x_checks.values():
                box.close()
            x_checks.clear()
            x_cache.clear()
            x_ticked.clear()
            x_bounds.clear()
            state["x_values"].clear()
            state["x_ranges"].clear()
            for name in cols:
                box = widgets.Checkbox(
                    value=False, description=str(name), indent=False,
                    disabled=name == y_menu.value,
                    layout=widgets.Layout(width="auto"))
                box.observe(lambda change, n=name: update_x_list(change, n),
                            names="value")
                x_checks[name] = box
            x_check_box.children = list(x_checks.values())
        finally:
            ui["loading"] = False
        update_x_list()

    def build_filter(d, xs):
        """
        Returns (mask, descriptions). mask is True for rows that are kept.
        Empty values in a filtered column are always kept.
        """
        mask = pd.Series(True, index=d.index)
        descriptions = []
        for x in xs:
            if is_num_x(x):
                r = state["x_ranges"].get(x)
                if not r or not r["on"]:
                    continue
                err = range_error(r)
                if err:
                    raise ValueError(f"{x}: {err}")
                nums = _as_float(d[x])
                keep = nums.between(r["lo"], r["hi"], inclusive="both") | d[x].isna()
                text = f"{x}: range [{r['lo']:.15g}, {r['hi']:.15g}]"
            else:
                values = state["x_values"].get(x, [])
                if not values:
                    continue
                keep = d[x].isin(values) | d[x].isna()
                text = f"{x}: values {values}"
            descriptions.append(f"{text}, removes {int((~keep).sum())} rows")
            mask &= keep
        return mask, descriptions

    def apply_filter(b):
        ready = False
        with apply_out:
            clear_output()
            reset_downstream()
            if state["raw"] is None:
                print("Load data first (step 1).")
                return
            y = y_menu.value
            xs = [n for n, box in x_checks.items() if box.value and n != y]
            if y is None:
                print("Pick Y.")
                return
            if not xs:
                print("Pick at least one X.")
                return
            try:
                mask, filters = build_filter(state["raw"], xs)
            except ValueError as e:
                print(f"Filter error: {e}")
                return
            d = state["raw"][mask].copy()
            state["filtered"] = d
            state["selection"] = {
                "y": y, "xs": xs, "filters": filters,
                "rows_before": int(len(state["raw"])), "rows_after": int(len(d)),
            }
            print(f"Y: {y}")
            print(f"X: {xs}")
            if filters:
                print("Active filters:")
                for f in filters:
                    print(f"  {f}")
            else:
                print("No active filters. All rows kept.")
            print(f"Rows: {len(state['raw'])} before, {len(d)} after filtering.")
            before = state["raw"][y].value_counts(dropna=False)
            after = d[y].value_counts(dropna=False)
            table = pd.DataFrame({"before": before, "after": after}).fillna(0).astype(int)
            table = table[table["before"] > 0]
            table["removed"] = table["before"] - table["after"]
            print("\nRows per Y level before and after filtering (Y itself is "
                  "not filtered, only through X):")
            print(table.to_string())
            print("\nGo on to step 3 or 4.")
            ready = True
        if ready:
            _run_callbacks(state, "filtered")

    step2 = widgets.VBox([
        widgets.HTML("<b>Step 2: pick Y, X and filter rows</b>"),
        widgets.HBox([
            widgets.VBox([y_menu], layout=widgets.Layout(margin="0 20px 0 0")),
            widgets.VBox([
                widgets.HTML("<b>X columns</b>"),
                widgets.Box([x_check_box], layout=widgets.Layout(
                    border="1px solid gray", height="250px", width="250px",
                    overflow="auto"))
            ], layout=widgets.Layout(margin="0 20px 0 0")),
            widgets.VBox([
                widgets.HTML("<b>X values (filter)</b>"),
                x_active, x_cat_panel, x_num_panel, x_status
            ])
        ], layout=widgets.Layout(flex_flow="row wrap", align_items="flex-start")),
        widgets.HTML(
            "Y should be categorical. Y is never filtered; only chosen X values "
            "decide which rows are kept. Rows with an empty value in a filtered "
            "column are kept. No recoding happens here."),
        apply_btn, apply_out,
    ])

    apply_btn.on_click(apply_filter)
    y_menu.observe(y_changed, names="value")
    x_active.observe(switch_x, names="value")
    x_search.observe(search_x, names="value")
    x_all_btn.on_click(select_all_x)
    x_clear_btn.on_click(clear_x)
    for ctrl in (x_use_range, x_lo, x_hi, x_slider):
        ctrl.observe(range_changed, names="value")
    x_range_reset.on_click(reset_range)
    x_prev.on_click(lambda b: move_page(-1))
    x_next.on_click(lambda b: move_page(1))

    state["widgets"]["select"] = {
        "y": y_menu, "x": x_check_box, "x_checks": x_checks,
        "x_active": x_active, "x_search": x_search, "x_all": x_all_btn,
        "x_clear": x_clear_btn, "x_value_boxes": x_visible,
        "x_status": x_status, "x_prev": x_prev, "x_next": x_next,
        "x_use_range": x_use_range, "x_lo": x_lo, "x_hi": x_hi,
        "x_slider": x_slider, "x_range_reset": x_range_reset,
        "apply": apply_btn, "apply_out": apply_out,
    }

    state["_callbacks"]["raw"]["select"] = fill_menus
    if state["raw"] is not None:
        fill_menus()
    else:
        y_menu.options = []
    display(step2)


# ---- Step 3: distribution checks ----------------------------------------------

def group_distribution_check(df, group_a, group_b, value_col, max_groups=25, dpi=100):
    """
    Distribution and normality checks for value_col per group_a x group_b.

    Shows two figures in the notebook: a grid with histogram+KDE, boxplot and
    Q-Q plot per group, and one overview boxplot coloured by group_b.
    Prints descriptive statistics and Shapiro-Wilk per group.
    Stops with ValueError if the number of groups is above max_groups.

    Returns summary (pd.DataFrame).
    """
    d = df[[group_a, group_b, value_col]].copy()
    d[value_col] = _as_float(d[value_col])

    groups = [(k, g) for k, g in d.groupby([group_a, group_b], observed=True)
              if g[value_col].notna().any()]
    n_groups = len(groups)
    if n_groups == 0:
        raise ValueError(f"No groups with values in {value_col}.")
    if n_groups > max_groups:
        raise ValueError(
            f"{n_groups} groups ({group_a} x {group_b}), the limit is "
            f"{max_groups}. Filter in step 2 or pick a categorical column "
            "with fewer levels.")

    # Descriptive statistics and normality test per group
    desc = d.groupby([group_a, group_b], observed=True)[value_col].agg(
        n="count", mean="mean", std="std", skew="skew",
        kurtosis=lambda x: x.kurt()
    ).round(2)

    rows = []
    for (g1, g2), g in groups:
        vals = g[value_col].dropna().to_numpy()
        if len(vals) >= 3 and np.std(vals) > 0:
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")
                W, p = stats.shapiro(vals)
        else:
            W, p = np.nan, np.nan
        rows.append({group_a: g1, group_b: g2, "shapiro_W": W, "shapiro_p": p})
    shapiro_results = pd.DataFrame(rows).set_index([group_a, group_b])
    summary = desc.join(shapiro_results, how="inner")
    summary["normal_at_5pct"] = summary["shapiro_p"] > 0.05
    summary["low_n_warning"] = summary["n"] < 20   # Shapiro unreliable at low n

    # Figure 1: grid with histogram+KDE, boxplot, Q-Q plot per group
    fig, axes = plt.subplots(n_groups, 3, figsize=(15, 4 * n_groups), dpi=dpi)
    if n_groups == 1:
        axes = axes.reshape(1, 3)
    fig.suptitle(f"Checks: {value_col} distribution per {group_a} x {group_b}",
                 fontsize=16, y=1.005)

    for row_i, ((g1, g2), gdf) in enumerate(groups):
        vals = gdf[value_col].dropna().to_numpy()

        ax = axes[row_i, 0]
        if len(vals) >= 2:
            ax.hist(vals, bins=min(12, max(3, len(vals) // 3)), density=True,
                    alpha=0.6, color="steelblue", edgecolor="white")
            if len(vals) >= 3 and np.std(vals) > 0:
                kde = stats.gaussian_kde(vals)
                xs = np.linspace(vals.min(), vals.max(), 200)
                ax.plot(xs, kde(xs), color="darkred", lw=2)
        ax.set_title(f"{g1} - {g2}\nHistogram + KDE (n={len(vals)})")
        ax.set_xlabel(value_col)

        ax = axes[row_i, 1]
        ax.boxplot(vals, patch_artist=True,
                   boxprops=dict(facecolor="lightgreen", alpha=0.7))
        ax.set_title(f"{g1} - {g2}\nBoxplot")
        ax.set_xticks([])

        ax = axes[row_i, 2]
        if len(vals) >= 3:
            stats.probplot(vals, dist="norm", plot=ax)
            p_val = shapiro_results.loc[(g1, g2), "shapiro_p"]
            ax.set_title(f"{g1} - {g2}\nQ-Q plot (Shapiro p={p_val:.3f})")
        else:
            ax.text(0.5, 0.5, "Too few obs.", ha="center", va="center")
            ax.set_title(f"{g1} - {g2}\nQ-Q plot")

    plt.tight_layout()
    display(fig)
    plt.close(fig)

    # Figure 2: overview boxplot, coloured by group_b
    a_vals = list(d[group_a].dropna().unique())
    b_vals = list(d[group_b].dropna().unique())
    palette = plt.cm.tab10(np.linspace(0, 1, len(b_vals)))
    color_map = dict(zip(b_vals, palette))

    fig2, ax = plt.subplots(figsize=(max(9, 1.8 * n_groups), 5.5), dpi=dpi)
    positions, data_to_plot, labels, colors = [], [], [], []
    pos = 0
    for a in a_vals:
        for b in b_vals:
            sub = d[(d[group_a] == a) & (d[group_b] == b)][value_col].dropna()
            if len(sub) == 0:
                continue
            data_to_plot.append(sub.to_numpy())
            labels.append(f"{a}\n{b}")
            colors.append(color_map[b])
            positions.append(pos)
            pos += 1
        pos += 0.5

    bp = ax.boxplot(data_to_plot, positions=positions, patch_artist=True, widths=0.6)
    for patch, color in zip(bp["boxes"], colors):
        patch.set_facecolor(color)
        patch.set_alpha(0.7)
    ax.set_xticks(positions)
    ax.set_xticklabels(labels, fontsize=9)
    ax.set_ylabel(value_col)
    ax.set_title(f"Overview: {value_col} spread per {group_a} and {group_b}")
    ax.legend(handles=[Patch(facecolor=color_map[b], label=str(b)) for b in b_vals])
    plt.tight_layout()
    display(fig2)
    plt.close(fig2)

    print("=== Summary per group ===")
    print(summary.to_string())
    print("\nNote: Shapiro-Wilk almost always gives p below 0.05 when n is large, "
          "whatever the distribution looks like. Look at the histogram and Q-Q "
          "plot, not only the p-value. Below n = 20 the test is unreliable "
          "(low_n_warning).")
    return summary


def step_diagnostics(state):
    """
    Step 3: distribution checks. Y from step 2 is the first categorical
    column. Pick one more categorical column and one numeric column, and
    press "Show checks". Uses the filtered data from step 2.
    The summary table is stored in state["diagnostics"].
    """
    w = {"description_width": "90px"}
    y_html = widgets.HTML()
    cat_menu = widgets.Dropdown(options=[], description="Categorical:", style=w,
                                layout=widgets.Layout(width="330px"))
    num_menu = widgets.Dropdown(options=[], description="Numeric:", style=w,
                                layout=widgets.Layout(width="330px"))
    max_field = widgets.IntText(value=25, description="Max groups:", style=w,
                                layout=widgets.Layout(width="220px"))
    show_btn = widgets.Button(description="Show checks", button_style="info",
                              layout=widgets.Layout(width="200px"))
    out = widgets.Output()

    def fill():
        if state["filtered"] is None or state["selection"] is None:
            y_html.value = "Run 'Apply and filter' in step 2 first."
            cat_menu.options = []
            num_menu.options = []
            return
        d, y, xs = state["filtered"], state["selection"]["y"], state["selection"]["xs"]
        y_html.value = f"Y (categorical): <b>{y}</b>"
        cat = [c for c in d.columns if c != y and _is_cat(d[c])]
        num = [c for c in d.columns if c != y and _is_num(d[c])]
        # chosen X first, then the rest
        cat = [c for c in xs if c in cat] + [c for c in cat if c not in xs]
        num = [c for c in xs if c in num] + [c for c in num if c not in xs]
        cat_menu.options = [(str(c), c) for c in cat]
        num_menu.options = [(str(c), c) for c in num]

    def show(b):
        with out:
            clear_output()
            if state["filtered"] is None:
                print("Run 'Apply and filter' in step 2 first.")
                return
            if cat_menu.value is None or num_menu.value is None:
                print("Pick both a categorical and a numeric column.")
                return
            try:
                state["diagnostics"] = group_distribution_check(
                    state["filtered"], state["selection"]["y"], cat_menu.value,
                    num_menu.value, max_groups=int(max_field.value))
            except ValueError as e:
                print(f"Stopped: {e}")

    show_btn.on_click(show)
    state["_callbacks"]["filtered"]["diagnostics"] = fill
    fill()
    state["widgets"]["diagnostics"] = {"cat": cat_menu, "num": num_menu,
                                       "max": max_field, "show": show_btn, "output": out}
    display(widgets.VBox([
        widgets.HTML("<b>Step 3: distribution checks per group</b>"),
        y_html,
        widgets.HBox([cat_menu, num_menu, max_field]),
        widgets.HTML("<small>Groups = Y levels times levels of the categorical "
                     "column. Each group gives one row of three plots.</small>"),
        show_btn, out,
    ]))


